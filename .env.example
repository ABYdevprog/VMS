# VMS — Otonom Yazılım Ajansı Ortam Değişkenleri (Tamamı Opsiyoneldir)
# Boş bırakıldığında Antigravity Yerleşik Modda ($0 API maliyetiyle) çalışır.

# Opsiyonel: Google AI Studio Anahtarı (gemini-4-hydrogen ücretsiz / gemini-4-carbon kredili)
GEMINI_API_KEY=

# Opsiyonel: Resmi Meta WhatsApp Cloud API (Kullanılmazsa Kokpitten QR Kod ile bağlanır)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Veritabanı yolu (Varsayılan: ./data/vms.db)
VMS_DB_PATH=./data/vms.db
